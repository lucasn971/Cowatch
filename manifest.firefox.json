{
  "manifest_version": 3,
  "name": "Cowatch — regarder ensemble",
  "version": "0.9.3",
  "description": "Regardez Netflix, Prime Video, Canal+, TF1+ ou Disney+ ensemble à distance : voix, chat, réactions et vidéo calée pour tous.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.canalplus.com/*",
    "*://*.paramountplus.com/*",
    "*://*.tf1.fr/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.fr/*",
    "*://*.disneyplus.com/*",
    "*://*.netflix.com/*",
    "*://*.youtube.com/*",
    "https://salon-coche-private.onrender.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.animationdigitalnetwork.fr/*",
    "*://*.animationdigitalnetwork.com/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Ouvrir Cowatch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.canalplus.com/*",
        "*://*.paramountplus.com/*",
        "*://*.tf1.fr/*",
        "*://*.primevideo.com/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.animationdigitalnetwork.fr/*",
        "*://*.animationdigitalnetwork.com/*",
        "http://localhost/*"
      ],
      "js": [
        "clock.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.canalplus.com/*",
        "*://*.paramountplus.com/*",
        "*://*.tf1.fr/*",
        "*://*.primevideo.com/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.animationdigitalnetwork.fr/*",
        "*://*.animationdigitalnetwork.com/*",
        "http://localhost/*"
      ],
      "js": [
        "themes.js",
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://salon-coche-private.onrender.com/j/*",
        "https://salon-coche-private.onrender.com/installer*",
        "http://localhost/installer*",
        "http://localhost/j/*"
      ],
      "js": [
        "join.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "Cowatch",
    "default_icon": "icons/32.png",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "salon@cowatch.app",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "commands": {
    "toggle-mic": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Couper / réactiver le micro Cowatch"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff"
      ],
      "matches": [
        "*://*.canalplus.com/*",
        "*://*.paramountplus.com/*",
        "*://*.tf1.fr/*",
        "*://*.primevideo.com/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.animationdigitalnetwork.fr/*",
        "*://*.animationdigitalnetwork.com/*",
        "http://localhost/*"
      ]
    }
  ]
}
