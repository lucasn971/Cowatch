{
  "manifest_version": 3,
  "name": "Cowatch — regarder ensemble",
  "version": "0.4.0",
  "description": "Regardez Canal+, Paramount+ ou TF1+ à plusieurs à distance : voix, chat, réactions et lecture synchronisée.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.canalplus.com/*",
    "*://*.paramountplus.com/*",
    "*://*.tf1.fr/*",
    "*://*.primevideo.com/*",
    "*://*.youtube.com/*",
    "https://salon-coche-private.onrender.com/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Ouvrir Cowatch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.canalplus.com/*",
        "*://*.paramountplus.com/*",
        "*://*.tf1.fr/*",
        "*://*.primevideo.com/*",
        "*://*.youtube.com/*",
        "http://localhost/*"
      ],
      "js": [
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://salon-coche-private.onrender.com/j/*",
        "http://localhost/j/*"
      ],
      "js": [
        "join.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "Cowatch",
    "default_icon": "icons/32.png",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "salon@cowatch.app",
      "strict_min_version": "121.0"
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  }
}