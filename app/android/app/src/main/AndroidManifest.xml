<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le strict nécessaire. Pas d'accès aux contacts, à la position ni à l'identifiant publicitaire.
         Mode A (regarder dans l'appli officielle) : « afficher par-dessus » pour la bulle du salon, accordé à la main par
         l'utilisateur, facultatif ; et l'accès aux lecteurs des autres applis (service EcouteNotifications ci-dessous). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Mode A : pouvoir ouvrir ces applis officielles (et seulement elles), comme dans app/web/applis.json. -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.canal.android.canal" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.google.android.youtube" />
        <package android:name="fr.tf1.mytf1" />
        <package android:name="fr.m6.m6replay" />
        <package android:name="fr.francetv.pluzz" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Cowatch"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lien d'invitation …/j/CODE : s'ouvre dans l'appli si elle est installée (vérification par
                 /.well-known/assetlinks.json sur le serveur, à ajouter avec l'empreinte de la clé de signature). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="salon-coche-private.onrender.com" android:pathPrefix="/j/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cowatch" android:host="j" />
            </intent-filter>
        </activity>

        <!-- Notification du salon : garde la voix quand l'écran s'éteint ; boutons « micro » et « quitter ». -->
        <service
            android:name=".SalonService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- Mode A : exigé par Android pour voir le lecteur des autres applis (MediaSessionManager). Volontairement vide :
             Cowatch ne lit aucune notification (vérifié par zero-revente.js). -->
        <service
            android:name=".EcouteNotifications"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
